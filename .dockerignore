# Build artifacts and deps - re-installed inside the build stages
**/node_modules
**/dist
**/.vite
**/.turbo
**/coverage

# Version control
.git
.gitignore
.github

# Local env / secrets - server reads these from compose, never from build context
.env
.env.*
**/.env
**/.env.*

# Editor / OS junk
.vscode
.idea
**/.DS_Store
**/Thumbs.db
**/*.swp

# Top-level meta - not needed at runtime.
# IMPORTANT: do NOT blanket-exclude **/*.md. The client bundles app/docs/**/*.md
# at build time (via import.meta.glob) to render them at /docs in the app -
# a wildcard exclusion here silently produces an empty docs site.
/README.md
/DEPLOYMENT.md
/CHANGELOG.md

# Docker / deploy meta - not needed inside the image
Dockerfile
docker-compose.yml
.dockerignore
deploy.sh

# Logs and tmp scratch
**/*.log
**/tmp
**/temp

# SQL - used by the Postgres container (compose volume), never by the app build
/db
