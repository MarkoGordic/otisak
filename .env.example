# Database
DATABASE_URL=postgresql://otisak:otisak@localhost:5432/otisak

# Session
SESSION_SECRET=change-me-to-a-random-64-char-string

# App
PORT=3001
CLIENT_URL=http://localhost:5173
CLIENT_DIST_PATH=../client/dist

# ---------------------------------------------------------------------------
# OPTIONAL: "Continue with ELPIS ID" (OAuth 2.0 / OIDC single sign-on).
# Leave ELPIS_ID_ENABLED unset (or false) and OTISAK behaves exactly as a
# standalone local-auth app — no login button, no extra routes. Set all of
# ENABLED + ISSUER + CLIENT_ID + CLIENT_SECRET to turn it on. Login is
# link-only: an ELPIS ID only works once it's linked to an OTISAK account.
# ---------------------------------------------------------------------------
# ELPIS_ID_ENABLED=true
# ELPIS_ID_ISSUER=https://auth.gordic.rs
# ELPIS_ID_CLIENT_ID=elpis_otisak_xxxxxx
# ELPIS_ID_CLIENT_SECRET=eid_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (sensible defaults are derived from the above):
#   ELPIS_ID_REDIRECT_URI      default: <request origin>/api/auth/elpis/callback
#   ELPIS_ID_SCOPES            default: openid profile email
#   ELPIS_ID_JWKS_URL          default: <issuer>/.well-known/jwks.json
# Optional: restrict which caller client_ids may hit the /integration WRITE
# endpoints (CSV). Unset = any valid ELPIS ID service token is accepted.
#   ELPIS_ID_INTEGRATION_ALLOWED_CLIENTS=elpis_main_xxxxxx
