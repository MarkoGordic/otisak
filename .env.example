# Database
DATABASE_URL=postgresql://otisak:otisak@localhost:5432/otisak

# Session
SESSION_SECRET=change-me-to-a-random-64-char-string

# App
PORT=3001
CLIENT_URL=http://localhost:5173
CLIENT_DIST_PATH=../client/dist

# ---------------------------------------------------------------------------
# OPTIONAL: "Continue with ELPIS ID" (OAuth 2.0 / OIDC single sign-on).
# Leave ELPIS_ID_ENABLED unset (or false) and OTISAK behaves exactly as a
# standalone local-auth app — no login button, no extra routes. Set all of
# ENABLED + ISSUER + CLIENT_ID + CLIENT_SECRET to turn it on. Login is
# link-only: an ELPIS ID only works once it's linked to an OTISAK account.
# ---------------------------------------------------------------------------
# ELPIS_ID_ENABLED=true
# ELPIS_ID_ISSUER=https://auth.gordic.rs
# ELPIS_ID_CLIENT_ID=elpis_otisak_xxxxxx
# ELPIS_ID_CLIENT_SECRET=eid_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (sensible defaults are derived from the above):
#   ELPIS_ID_REDIRECT_URI      default: <request origin>/api/auth/elpis/callback
#   ELPIS_ID_SCOPES            default: openid profile email
#   ELPIS_ID_JWKS_URL          default: <issuer>/.well-known/jwks.json
# Optional: restrict which caller client_ids may hit the /integration WRITE
# endpoints (CSV). Unset = any valid ELPIS ID service token is accepted.
#   ELPIS_ID_INTEGRATION_ALLOWED_CLIENTS=elpis_main_xxxxxx
# Optional: HMAC secret for receiving signed push webhooks from ELPIS ID at
# POST /integration/events (profile sync + remote session revocation). Must
# match the secret configured on the otisak app in the ELPIS ID admin.
# Unset = the receiver endpoint stays 404.
#   ELPIS_ID_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# OPTIONAL: FreeIPA / LDAP login. When enabled it becomes the DEFAULT login on
# the sign-in page (staff + students use their IPA username/index + password;
# an OTISAK account is auto-provisioned/linked on first login). Local
# email+password login stays as a fallback. Set LDAP_ENABLED + LDAP_URL +
# LDAP_BASE_DN to turn it on. We bind directly as the user
# (uid=<login>,cn=users,cn=accounts,<base>) — no service/bind account needed.
# ---------------------------------------------------------------------------
# LDAP_ENABLED=true
# LDAP_URL=ldaps://192.168.1.247:636          # FreeIPA server (ldaps recommended)
# LDAP_BASE_DN=dc=labs,dc=acs,dc=uns,dc=ac,dc=rs
# LDAP_DOMAIN=labs.acs.uns.ac.rs              # email fallback: <uid>@<domain> when the entry has no mail
# LDAP_CA_FILE=/etc/otisak/ipa-ca.crt         # CA that signs the ldaps cert (verify TLS); omit to use system CAs
# Role mapping from IPA group membership (CSV of group cn; defaults shown):
#   LDAP_ADMIN_GROUPS=admins
#   LDAP_ASSISTANT_GROUPS=assistants
# everyone else -> student. Optional:
#   LDAP_USER_DN_TEMPLATE=uid={uid},cn=users,cn=accounts,{base}   # default; {uid} and {base} are substituted
#   LDAP_TLS_INSECURE=true                     # skip ldaps cert verification (DEV ONLY, never in prod)
#   LDAP_TIMEOUT_MS=8000
